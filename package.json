{
  "name": "swiftui-react-native",
  "version": "7.0.0-beta.1",
  "description": "Real SwiftUI views for React Native, built on Fabric, Codegen and Nitro Modules",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/runtime/react-native/index.d.ts",
  "exports": {
    ".": {
      "swiftui-react-native-source": "./runtime/react-native/index.ts",
      "types": "./lib/typescript/runtime/react-native/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "runtime",
    "lib",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!runtime/apple/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace swiftui-react-native-example",
    "ios": "cd example && expo run:ios",
    "ios:device": "cd example && expo run:ios --device",
    "ios:release": "cd example && expo run:ios --configuration Release",
    "start": "cd example && expo start --dev-client",
    "start:clear": "cd example && expo start --dev-client --clear",
    "example:prebuild": "cd example && expo prebuild -p ios --clean",
    "example:pods": "cd example/ios && pod install",
    "example:typecheck": "cd example && tsc --noEmit",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "codegen": "react-native codegen --platform ios --outputPath .codegen",
    "typecheck": "tsc",
    "format": "prettier --write \"runtime/react-native/**/*.{ts,tsx}\" \"example/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "swiftui",
    "fabric",
    "new-architecture",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-levy/swiftui-react-native.git"
  },
  "author": "Andrew Levy <alevy97@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andrew-levy/swiftui-react-native/issues"
  },
  "homepage": "https://swiftui.rit3zh.dev",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@types/react": "^19.3.0",
    "del-cli": "^7.0.0",
    "nitrogen": "^0.37.2",
    "prettier": "^3.9.6",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "^0.37.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0",
    "react-native-nitro-modules": "^0.37.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "runtime/react-native",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
