{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "customConditions": ["swiftui-react-native-source"],
    "paths": {
      "swiftui-react-native": ["../runtime/react-native/index"],
      "swiftui-react-native/*": ["../runtime/react-native/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
